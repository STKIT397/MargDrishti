# Use ONE database configuration method.
# Recommended for Render PostgreSQL: copy the Internal Database URL from your Render database
# into the backend web service environment as DATABASE_URL.
DATABASE_URL=

# Alternative local configuration (used only when DATABASE_URL is empty):
DB_HOST=localhost
DB_PORT=5432
DB_NAME=margdrishti_semv
DB_USER=postgres
DB_PASSWORD=replace_with_your_local_password

# DB_SSL=true enables SSL. Production enables SSL by default unless DB_SSL=false.
# For a local PostgreSQL server, leave this unset or set DB_SSL=false.
DB_SSL=false

# Set a strong random secret in Render; do not use the development fallback.
SESSION_SECRET=replace_with_a_long_random_secret
